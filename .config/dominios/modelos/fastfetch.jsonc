// Dominio {{nome}}. Gerado por `dominio construir` a partir de modelos/fastfetch.jsonc.
// fish/init.fish troca o logo para a imagem (logo.png) quando o terminal e o kitty.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "{{raiz}}/_build/{{dominio}}/logo.txt",
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "{{cor.primaria|ansi}}", "output": "{{cor.texto|ansi}}" },
    "key": { "width": 18 },
    "bar": { "width": 14, "char": { "elapsed": "━", "total": "─" }, "border": null, "color": { "elapsed": "{{cor.primaria|ansi}}", "total": "{{cor.contorno|ansi}}" } },
    "percent": { "type": 3, "color": { "green": "{{cor.primaria|ansi}}", "yellow": "{{cor.aviso|ansi}}", "red": "{{cor.erro|ansi}}" } }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "{#1}{#{{cor.secundaria|ansi}}}{{ficha.titulo}}{#}" },
    { "type": "custom", "format": "{#{{cor.contorno|ansi}}}────────────────────────────────────{#}" },
    { "type": "title", "key": "{{ficha.usuario}}", "format": "{user-name}{#{{cor.texto_suave|ansi}}} em {#}{host-name}" },
    { "type": "os", "key": "{{ficha.so}}", "format": "{pretty-name}" },
    { "type": "kernel", "key": "{{ficha.kernel}}", "format": "{release}" },
    { "type": "uptime", "key": "{{ficha.uptime}}" },
    { "type": "packages", "key": "{{ficha.pacotes}}" },
    { "type": "wm", "key": "{{ficha.wm}}" },
    { "type": "terminal", "key": "{{ficha.terminal}}" },
    { "type": "custom", "format": "{#{{cor.contorno|ansi}}}────────────────────────────────────{#}" },
    { "type": "cpu", "key": "{{ficha.cpu}}", "format": "{name} ({cores-logical})" },
    { "type": "memory", "key": "{{ficha.memoria}}", "format": "{used} / {total}" },
    { "type": "disk", "key": "{{ficha.disco}}", "folders": "/", "format": "{size-used} / {size-total}" },
    { "type": "battery", "key": "{{ficha.bateria}}", "format": "{capacity} {status}" },
    { "type": "custom", "format": "{#{{cor.contorno|ansi}}}────────────────────────────────────{#}" },
    { "type": "custom", "format": "{#3}{#{{cor.texto_suave|ansi}}}{{lema}}{#}" },
    { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
  ]
}
