  "semanticTokenColors": {
    "comment": { "foreground": "{{cor.texto_suave|mistura:cor.fundo:0.2}}", "italic": true },
    "keyword": "{{ansi.magenta}}",
    "string": "{{ansi.verde}}",
    "number": "{{ansi.amarelo}}",
    "regexp": "{{ansi.verde_claro}}",
    "operator": "{{ansi.magenta_claro}}",
    "namespace": "{{ansi.magenta_claro}}",
    "type": "{{ansi.ciano}}",
    "class": "{{ansi.ciano}}",
    "struct": "{{ansi.ciano}}",
    "enum": "{{ansi.ciano}}",
    "interface": "{{ansi.ciano_claro}}",
    "typeParameter": "{{ansi.ciano_claro}}",
    "enumMember": "{{ansi.amarelo}}",
    "function": "{{ansi.azul}}",
    "method": "{{ansi.azul}}",
    "macro": "{{ansi.magenta_claro}}",
    "decorator": "{{ansi.magenta_claro}}",
    "variable": "{{cor.texto}}",
    "variable.defaultLibrary": "{{ansi.vermelho_claro}}",
    "parameter": { "foreground": "{{ansi.amarelo_claro}}", "italic": true },
    "selfParameter": { "foreground": "{{ansi.vermelho_claro}}", "italic": true },
    "clsParameter": { "foreground": "{{ansi.vermelho_claro}}", "italic": true },
    "property": "{{ansi.azul_claro}}",
    "label": "{{ansi.amarelo_claro}}",
    "*.deprecated": { "strikethrough": true }
  },
  "tokenColors": [
    {
      "name": "Comentarios",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "{{cor.texto_suave|mistura:cor.fundo:0.2}}", "fontStyle": "italic" }
    },
    {
      "name": "Texto e variaveis",
      "scope": ["variable", "variable.other", "meta.definition.variable", "support.variable", "string.unquoted.plain.out.yaml"],
      "settings": { "foreground": "{{cor.texto}}" }
    },
    {
      "name": "Pontuacao",
      "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator", "punctuation.accessor", "meta.delimiter"],
      "settings": { "foreground": "{{cor.texto_suave}}" }
    },
    {
      "name": "Palavras-chave e armazenamento",
      "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.other.unit", "variable.language.super"],
      "settings": { "foreground": "{{ansi.magenta}}" }
    },
    {
      "name": "Operadores",
      "scope": ["keyword.operator", "storage.type.function.arrow", "punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": { "foreground": "{{ansi.magenta_claro}}" }
    },
    {
      "name": "Operadores em palavras",
      "scope": ["keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python", "keyword.operator.wordlike"],
      "settings": { "foreground": "{{ansi.magenta}}" }
    },
    {
      "name": "Funcoes e metodos",
      "scope": ["entity.name.function", "support.function", "meta.function-call", "meta.function-call.generic", "variable.function", "entity.name.command"],
      "settings": { "foreground": "{{ansi.azul}}" }
    },
    {
      "name": "Argumentos de chamada voltam ao texto",
      "scope": ["meta.function-call.arguments", "meta.function-call punctuation"],
      "settings": { "foreground": "{{cor.texto}}" }
    },
    {
      "name": "Parametros",
      "scope": ["variable.parameter", "meta.function.parameters variable.other"],
      "settings": { "foreground": "{{ansi.amarelo_claro}}", "fontStyle": "italic" }
    },
    {
      "name": "this, self",
      "scope": ["variable.language", "variable.parameter.function.language.special"],
      "settings": { "foreground": "{{ansi.vermelho_claro}}", "fontStyle": "italic" }
    },
    {
      "name": "Tipos e classes",
      "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "entity.name.struct", "entity.name.enum", "storage.type.primitive", "storage.type.built-in", "meta.type.annotation entity.name"],
      "settings": { "foreground": "{{ansi.ciano}}" }
    },
    {
      "name": "Interfaces e parametros de tipo",
      "scope": ["entity.name.type.interface", "entity.name.type.parameter", "entity.name.type.alias", "support.type.primitive"],
      "settings": { "foreground": "{{ansi.ciano_claro}}" }
    },
    {
      "name": "Modulos e namespaces",
      "scope": ["entity.name.namespace", "entity.name.module", "entity.name.type.module", "entity.name.package", "support.module", "support.other.namespace"],
      "settings": { "foreground": "{{ansi.magenta_claro}}" }
    },
    {
      "name": "Propriedades e campos",
      "scope": ["variable.other.property", "variable.other.object.property", "variable.other.member", "meta.object-literal.key", "support.variable.property", "variable.other.enummember"],
      "settings": { "foreground": "{{ansi.azul_claro}}" }
    },
    {
      "name": "Textos",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string", "markup.inline.raw.string"],
      "settings": { "foreground": "{{ansi.verde}}" }
    },
    {
      "name": "Escapes, regex e interpolacao",
      "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder", "constant.character.format.placeholder", "keyword.other.special-method"],
      "settings": { "foreground": "{{ansi.verde_claro}}" }
    },
    {
      "name": "Numeros e constantes",
      "scope": ["constant.numeric", "constant.other", "constant.character", "variable.other.constant", "support.constant", "keyword.other.unit"],
      "settings": { "foreground": "{{ansi.amarelo}}" }
    },
    {
      "name": "Constantes da linguagem",
      "scope": ["constant.language", "constant.language.boolean", "constant.language.null", "constant.language.undefined"],
      "settings": { "foreground": "{{ansi.vermelho_claro}}" }
    },
    {
      "name": "Decoradores e anotacoes",
