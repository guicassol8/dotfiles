      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.other.attribute-name.pseudo-class", "entity.other.attribute-name.pseudo-element", "entity.other.attribute-name.parent-selector"],
      "settings": { "foreground": "{{ansi.amarelo}}", "fontStyle": "" }
