      "settings": { "foreground": "{{ansi.ciano_claro}}" }
    },
    {
      "name": "Markdown: titulos",
      "scope": ["markup.heading", "entity.name.section.markdown", "punctuation.definition.heading.markdown", "markup.heading.setext"],
      "settings": { "foreground": "{{cor.primaria}}", "fontStyle": "bold" }
    },
    {
      "name": "Markdown: negrito",
      "scope": ["markup.bold", "punctuation.definition.bold"],
      "settings": { "foreground": "{{ansi.amarelo_claro}}", "fontStyle": "bold" }
    },
    {
      "name": "Markdown: italico",
      "scope": ["markup.italic", "punctuation.definition.italic"],
      "settings": { "foreground": "{{ansi.magenta_claro}}", "fontStyle": "italic" }
    },
    {
      "name": "Markdown: riscado",
      "scope": ["markup.strikethrough"],
      "settings": { "foreground": "{{cor.texto_suave}}", "fontStyle": "strikethrough" }
