    // Setor 2814: a janela e um constructo. Projeta-se como luz solida verde
    // a partir de um feixe horizontal e so entao vira conteudo
    window-open {
        duration-ms 420
        curve "ease-out-cubic"
        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float sx = max(smoothstep(0.0, 0.5, p), 0.002);
                float sy = max(smoothstep(0.22, 1.0, p), 0.012);
                vec2 q = (coords_geo.xy - 0.5) / vec2(sx, sy) + 0.5;
                if (q.x < 0.0 || q.x > 1.0 || q.y < 0.0 || q.y > 1.0) return vec4(0.0);
                vec3 ct = niri_geo_to_tex * vec3(q, 1.0);
                vec4 cor = texture2D(niri_tex, ct.st);
                vec3 verde = vec3({{cor.primaria|glsl}});
                float energia = 1.0 - smoothstep(0.45, 1.0, p);
                float trama = 0.82 + 0.18 * sin((q.x + q.y) * size_geo.x * 0.35);
                cor = mix(cor, vec4(verde * trama, 1.0), energia * 0.92);
                return cor;
            }
        "
    }
    // ...e se recolhe para um ponto, como um anel sem carga
    window-close {
        duration-ms 320
        curve "ease-out-quad"
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float sy = max(1.0 - smoothstep(0.0, 0.55, p), 0.010);
                float sx = max(1.0 - smoothstep(0.45, 1.0, p), 0.001);
                vec2 q = (coords_geo.xy - 0.5) / vec2(sx, sy) + 0.5;
                if (q.x < 0.0 || q.x > 1.0 || q.y < 0.0 || q.y > 1.0) return vec4(0.0);
                vec3 ct = niri_geo_to_tex * vec3(q, 1.0);
                vec4 cor = texture2D(niri_tex, ct.st);
                vec3 verde = vec3({{cor.primaria|glsl}});
                cor = mix(cor, vec4(verde, 1.0), smoothstep(0.0, 0.5, p) * 0.95);
                return cor * (1.0 - smoothstep(0.85, 1.0, p));
            }
        "
    }
    workspace-switch {
        spring damping-ratio=0.85 stiffness=900 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }
