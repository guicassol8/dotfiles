# Dominio {{nome}}. Gerado por `dominio construir`. Os seis elementos nos graficos.
theme[main_bg]="{{cor.fundo}}"
theme[main_fg]="{{cor.texto}}"
theme[title]="{{cor.secundaria}}"
theme[hi_fg]="{{elementos.eletricidade}}"
theme[selected_bg]="{{cor.superficie2}}"
theme[selected_fg]="{{cor.secundaria}}"
theme[inactive_fg]="{{cor.contorno}}"
theme[graph_text]="{{cor.texto_suave}}"
theme[meter_bg]="{{cor.superficie2}}"
theme[proc_misc]="{{elementos.vento}}"
theme[cpu_box]="{{elementos.mana-pura}}"
theme[mem_box]="{{elementos.agua}}"
theme[net_box]="{{elementos.vento}}"
theme[proc_box]="{{elementos.terra}}"
theme[div_line]="{{cor.contorno}}"
theme[temp_start]="{{elementos.vento}}"
theme[temp_mid]="{{elementos.eletricidade}}"
theme[temp_end]="{{elementos.fogo}}"
theme[cpu_start]="{{elementos.agua}}"
theme[cpu_mid]="{{elementos.mana-pura}}"
theme[cpu_end]="{{elementos.fogo}}"
theme[free_start]="{{elementos.vento|escuro:0.4}}"
theme[free_mid]="{{elementos.vento}}"
theme[free_end]="{{elementos.vento|claro:0.3}}"
theme[cached_start]="{{elementos.agua|escuro:0.4}}"
theme[cached_mid]="{{elementos.agua}}"
theme[cached_end]="{{elementos.agua|claro:0.3}}"
theme[available_start]="{{elementos.terra|escuro:0.4}}"
theme[available_mid]="{{elementos.terra}}"
theme[available_end]="{{elementos.terra|claro:0.3}}"
theme[used_start]="{{elementos.mana-pura}}"
theme[used_mid]="{{elementos.eletricidade}}"
theme[used_end]="{{elementos.fogo}}"
theme[download_start]="{{elementos.agua|escuro:0.4}}"
theme[download_mid]="{{elementos.agua}}"
theme[download_end]="{{elementos.vento}}"
theme[upload_start]="{{elementos.mana-pura|escuro:0.4}}"
theme[upload_mid]="{{elementos.mana-pura}}"
theme[upload_end]="{{elementos.eletricidade}}"
theme[process_start]="{{elementos.vento}}"
theme[process_mid]="{{elementos.eletricidade}}"
theme[process_end]="{{elementos.fogo}}"
