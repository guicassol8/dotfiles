    // Grimorio: a janela se materializa de um mosaico de pixels que vai afinando
    // (48, 24, 12, 6, 3 px: sempre na grade de 3), com faisca na cor do elemento
    // em cada bloco que acende. So roda durante a animacao: parado, custo zero.
    window-open {
        duration-ms 460
        curve "linear"
        custom-shader r"
            float g_hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                vec2 uv = coords_geo.xy;
                if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) return vec4(0.0);
                vec2 px = uv * size_geo.xy;
                float bloco = p < 0.22 ? 48.0 : p < 0.42 ? 24.0 : p < 0.60 ? 12.0 : p < 0.76 ? 6.0 : p < 0.88 ? 3.0 : 0.0;
                vec2 alvo = uv;
                if (bloco > 0.0) alvo = (floor(px / bloco) + 0.5) * bloco / size_geo.xy;
                // cada celula de 24 px acende num instante sorteado, todas ate 62%
                float h = g_hash(floor(px / 24.0) + niri_random_seed * 91.0);
                float t = p - h * 0.62;
                if (t < 0.0) return vec4(0.0);
                vec4 cor = texture2D(niri_tex, (niri_geo_to_tex * vec3(alvo, 1.0)).st);
                vec3 elemento = vec3({{elemento.cor|glsl}});
                float faisca = clamp(1.0 - t / 0.16, 0.0, 1.0);
                cor.rgb = mix(cor.rgb, elemento * cor.a, faisca * 0.85);
                float a = clamp(t / 0.06, 0.0, 1.0);
                return cor * a;
            }
        "
    }
    // ...e fecha se desfazendo: os blocos engrossam, piscam no elemento e somem
    window-close {
        duration-ms 380
        curve "linear"
        custom-shader r"
            float g_hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                vec2 uv = coords_geo.xy;
                if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) return vec4(0.0);
                vec2 px = uv * size_geo.xy;
                float bloco = p < 0.12 ? 3.0 : p < 0.28 ? 6.0 : p < 0.48 ? 12.0 : p < 0.70 ? 24.0 : 48.0;
                vec2 alvo = (floor(px / bloco) + 0.5) * bloco / size_geo.xy;
                float h = g_hash(floor(px / 24.0) + niri_random_seed * 91.0);
                // a celula some entre 25% e 100%, piscando no elemento antes
                float t = (0.25 + h * 0.75) - p;
                if (t < 0.0) return vec4(0.0);
                vec4 cor = texture2D(niri_tex, (niri_geo_to_tex * vec3(alvo, 1.0)).st);
                vec3 elemento = vec3({{elemento.cor|glsl}});
                float faisca = clamp(1.0 - t / 0.14, 0.0, 1.0);
                cor.rgb = mix(cor.rgb, elemento * cor.a, faisca * 0.9);
                return cor * clamp(t / 0.04, 0.0, 1.0);
            }
        "
    }
    // Trocas de sala e de coluna: mola um pouco abaixo do amortecimento critico. Chega
    // antes que a mola antiga (95% em ~145 ms) e assenta passando uns 8 a 10 px do alvo,
    // quieta em ~370 ms. Estes tres so aceitam mola ou curva (sem shader no niri 26.04).
    workspace-switch {
        spring damping-ratio=0.84 stiffness=620 epsilon=0.0001
    }
    // o deslize quando o foco muda de coluna
    horizontal-view-movement {
        spring damping-ratio=0.86 stiffness=700 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.86 stiffness=640 epsilon=0.0001
    }
