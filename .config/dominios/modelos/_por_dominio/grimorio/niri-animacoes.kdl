    // Grimorio: a janela surge como tinta se espalhando no papel
    window-open {
        duration-ms 520
        curve "ease-out-cubic"
        custom-shader r"
            float g_hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
            float g_ruido(vec2 p) {
                vec2 i = floor(p); vec2 f = fract(p);
                f = f * f * (3.0 - 2.0 * f);
                return mix(mix(g_hash(i), g_hash(i + vec2(1.0, 0.0)), f.x),
                           mix(g_hash(i + vec2(0.0, 1.0)), g_hash(i + vec2(1.0, 1.0)), f.x), f.y);
            }
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                vec2 uv = coords_geo.xy;
                if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) return vec4(0.0);
                vec2 prop = vec2(size_geo.x / size_geo.y, 1.0);
                float r = length((uv - 0.5) * prop) / length(prop * 0.5);
                vec2 px = uv * size_geo.xy;
                float n = g_ruido(px / 46.0 + niri_random_seed * 17.0) * 0.6 + g_ruido(px / 13.0) * 0.4;
                float d = p * 1.45 - (r + (n - 0.5) * 0.34);
                vec3 ct = niri_geo_to_tex * vec3(uv, 1.0);
                vec4 cor = texture2D(niri_tex, ct.st) * smoothstep(0.0, 0.11, d);
                vec3 mana = vec3({{cor.primaria|glsl}});
                float aura = smoothstep(0.13, 0.0, abs(d - 0.04)) * (1.0 - p);
                cor += vec4(mana, 1.0) * aura * 0.5;
                return cor;
            }
        "
    }
    // ...e se recolhe das bordas para o centro
    window-close {
        duration-ms 420
        curve "ease-out-quad"
        custom-shader r"
            float g_hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
            float g_ruido(vec2 p) {
                vec2 i = floor(p); vec2 f = fract(p);
                f = f * f * (3.0 - 2.0 * f);
                return mix(mix(g_hash(i), g_hash(i + vec2(1.0, 0.0)), f.x),
                           mix(g_hash(i + vec2(0.0, 1.0)), g_hash(i + vec2(1.0, 1.0)), f.x), f.y);
            }
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                vec2 uv = coords_geo.xy;
                if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) return vec4(0.0);
                vec2 prop = vec2(size_geo.x / size_geo.y, 1.0);
                float r = length((uv - 0.5) * prop) / length(prop * 0.5);
                vec2 px = uv * size_geo.xy;
                float n = g_ruido(px / 46.0 + niri_random_seed * 17.0) * 0.6 + g_ruido(px / 13.0) * 0.4;
                float d = (1.0 - p) * 1.45 - (r + (n - 0.5) * 0.34);
                vec3 ct = niri_geo_to_tex * vec3(uv, 1.0);
                vec4 cor = texture2D(niri_tex, ct.st) * smoothstep(0.0, 0.11, d);
                vec3 mana = vec3({{cor.primaria|glsl}});
                float aura = smoothstep(0.13, 0.0, abs(d - 0.04)) * p * (1.0 - p) * 4.0;
                cor += vec4(mana, 1.0) * aura * 0.4;
                return cor;
            }
        "
    }
    workspace-switch {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.9 stiffness=600 epsilon=0.0001
    }
